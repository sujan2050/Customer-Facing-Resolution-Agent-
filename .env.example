# LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=your_gemini_api_key_here

# Database Configuration (Docker Compose uses postgresql://postgres:postgres@db:5432/resolution_agent_db)
DATABASE_URL=postgresql://postgres:postgres@db:5432/resolution_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resolution_agent_db

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Set to true for offline deterministic evaluation without LLM calls
MOCK_LLM=false
